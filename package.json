{
  "name": "micro-problems",
  "version": "0.0.0-development",
  "description": "A micro decorator that helps with throwing and reporting RFC 7807 JSON Problems",
  "main": "lib/index.js",
  "module": "src/index.js",
  "scripts": {
    "build": "babel src --out-dir lib --ignore 'src/**/*.spec.js'",
    "check-coverage": "jest --coverage",
    "commit": "git-cz",
    "lint": "standard",
    "report-coverage": "codecov",
    "semantic-release": "semantic-release",
    "tdd": "jest --watch",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/call-a3/micro-problems.git"
  },
  "bugs": {
    "url": "https://github.com/call-a3/micro-problems/issues"
  },
  "homepage": "https://github.com/call-a3/micro-problems#readme",
  "author": {
    "name": "Adriaan Callaerts",
    "email": "adriaan.callaerts@gmail.com",
    "url": "https://www.adriaan.me"
  },
  "license": "MIT",
  "keywords": [
    "micro",
    "decorator"
  ],
  "peerDependencies": {
    "micro": "9.x"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/preset-env": "^7.18.0",
    "@call-a3/standard": "^1.0.3",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@commitlint/travis-cli": "^17.0.0",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/git": "^10.0.1",
    "codecov": "^3.8.2",
    "commitizen": "^1.0.4",
    "commitlint": "^17.0.0",
    "cz-conventional-changelog": "^3.0.1",
    "husky": "^8.0.1",
    "jest": "^28.1.0",
    "lint-staged": "^12.4.1",
    "micro": "^9.3.4",
    "semantic-release": "^19.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "npm run check-coverage"
    }
  },
  "lint-staged": {
    "*.js": "standard --fix"
  },
  "standard-engine": {
    "name": "@call-a3/standard"
  },
  "release": {
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "jest": {
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
